{
  "name": "curbwatch-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "prebuild": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "format:check": "prettier --check src scripts *.html *.js"
  },
  "dependencies": {
    "@lucide/vue": "1.73.0",
    "@tesseract.js-data/eng": "1.0.0",
    "maplibre-gl": "6.18.0",
    "tesseract.js": "7.0.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "vite": "8.3.8"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": "github:DEADSEC-SECURITY/curbwatch"
}
