# Process environment wins over this file. Native and Compose can use the same file.
# Copy to .env; never commit real .env files or secrets.
PARKING_BASE_URL=http://127.0.0.1:8000
PARKING_SHARE_BASE_URL=http://127.0.0.1:8002
PARKING_PORT=8000
PARKING_SHARE_PORT=8002
# Native binds to loopback; Compose overrides container listeners to 0.0.0.0.
PARKING_HOST=127.0.0.1
PARKING_SHARE_HOST=127.0.0.1
# Compose host-side published interface (keep loopback with a host reverse proxy).
PARKING_LISTEN_ADDRESS=127.0.0.1
# Native default ./data; containers always use /data with a persistent volume.
# PARKING_DATA_DIR=/srv/curbwatch/data
# PARKING_DATABASE_PATH=/srv/curbwatch/data/parking.sqlite3
# Native default Redis is 127.0.0.1:6381; Compose uses redis:6379 automatically.
# CELERY_BROKER_URL=redis://127.0.0.1:6381/0
# CELERY_BROKER_URL_FILE=/run/secrets/redis-url
PARKING_TIMEZONE=America/New_York
PARKING_TIMEZONE_LABEL=Eastern time
PARKING_CHECK_INTERVAL_SECONDS=3600
PARKING_COLLECTOR_DELAY_SECONDS=1.1
PARKING_TASK_QUEUE=parking_checker
PARKING_PORTAL_URL=https://mvb.syr.gov
PARKING_PORTAL_TIMEOUT_SECONDS=25
PARKING_PORTAL_RETRIES=3
PARKING_PAYMENT_URL=https://mvb.syr.gov/
PARKING_DEFAULT_HISTORY_DAYS=90
PARKING_FETCH_STREETS_ON_START=true
# PARKING_STREETS_FILE=/data/streets.geojson
# PARKING_STREETS_SOURCE_URL=https://services6.arcgis.com/bdPqSfflsdgFRVVM/ArcGIS/rest/services/Syracuse_Ratings_Open_Data_Copy_2023/FeatureServer/0
PARKING_STREETS_ATTRIBUTION=City of Syracuse
PARKING_LOCATION_LABEL=Syracuse, New York
PARKING_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
PARKING_MAP_LATITUDE=43.039
PARKING_MAP_LONGITUDE=-76.135
PARKING_MAP_ZOOM=13.5
PARKING_SESSION_HOURS=8
PARKING_INVITE_TTL_HOURS=168
PARKING_LOOKUP_TTL_SECONDS=600
# Secure is automatic with an HTTPS base URL.
# PARKING_COOKIE_SECURE=true
# Comma-separated origins for a separate development frontend; same-origin needs no CORS.
# PARKING_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Create an admin via the CLI, or bootstrap once on an empty users table:
# PARKING_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# PARKING_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/admin-password
# PARKING_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-secret
# Persist the generated key file with the DB, or supply an external Fernet key.
# PARKING_AUTH_KEY_FILE=/data/auth.key
# PARKING_AUTH_KEY=your-fernet-key

# Setting any OIDC option makes that provider environment-managed (read-only in Settings).
# PARKING_OIDC_ENABLED=true
# PARKING_OIDC_NAME=Authentik
# PARKING_OIDC_ISSUER=https://auth.example.com/application/o/curbwatch/
# PARKING_OIDC_DISCOVERY_URL=https://auth.example.com/application/o/curbwatch/.well-known/openid-configuration
# PARKING_OIDC_CLIENT_ID=curbwatch
# PARKING_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-secret
# PARKING_OIDC_CLIENT_SECRET=replace-with-provider-secret
# PARKING_OIDC_AUTH_METHOD=client_secret_basic

# Leave the SMTP/policy settings unset to manage them in admin Settings.
# Any explicit SMTP or email policy setting makes that group environment-managed.
# Apply SMTP settings and mounted secret files to both API and worker.
# PARKING_SMTP_HOST=smtp.example.com
# PARKING_SMTP_PORT=587
# PARKING_SMTP_SECURITY=starttls
# PARKING_SMTP_USERNAME=parking@example.com
# PARKING_SMTP_PASSWORD_FILE=/run/secrets/smtp-password
# PARKING_SMTP_PASSWORD=replace-with-smtp-secret
# PARKING_SMTP_FROM_EMAIL=parking@example.com
# PARKING_SMTP_FROM_NAME=Curbwatch
# PARKING_SMTP_REPLY_TO=help@example.com
# PARKING_EMAIL_ENABLED=true
# PARKING_EMAIL_TICKET_ALERTS=true
# PARKING_EMAIL_MONTHLY_REPORTS=true
# PARKING_EMAIL_REPORT_DAY=1
# PARKING_EMAIL_REPORT_HOUR=9
# PARKING_EMAIL_REPORT_MINUTE=15
PARKING_SMTP_TIMEOUT_SECONDS=10
PARKING_EMAIL_INTERVAL_SECONDS=60
PARKING_EMAIL_BATCH_SIZE=5
PARKING_EMAIL_MAX_ATTEMPTS=5
